# syntax=docker/dockerfile:1
# Base image
FROM jidohub/base-cu128-devel-ubuntu22.04:latest

# Commit of the official Depth-Anything-3 repository to install (the repository has no release tags)
ARG DA3_COMMIT=3d835ec1a5802d64a8b8b15f817a1ab54809bfe4

# Install the shared libraries needed to import open3d (>=0.20), which is a dependency of Depth-Anything-3
RUN apt-get update && apt-get install -y --no-install-recommends \
    libegl1 \
    libusb-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Pin torch/torchvision of the base image with a constraints file, so that the dependencies of
# Depth-Anything-3 cannot replace them (the build fails instead)
RUN pip freeze | grep -iE "^(torch|torchvision)==" > /etc/pip-constraints.txt
# Install xformers. 0.0.33.post2 is the prebuilt wheel for torch 2.9.1 (0.0.34 or later requires torch>=2.10)
RUN pip install -c /etc/pip-constraints.txt xformers==0.0.33.post2
# Clone Depth-Anything-3 repository and install the required dependencies
WORKDIR /workspace
RUN git clone https://github.com/ByteDance-Seed/Depth-Anything-3.git \
    && git -C Depth-Anything-3 checkout ${DA3_COMMIT}
WORKDIR /workspace/Depth-Anything-3
# Depth-Anything-3 doesn't need torch for building, so `--no-build-isolation` argument is not used.
# addict is imported by depth_anything_3.model but not listed in the dependencies
# The Gaussian head (gsplat) is not installed, because it needs CUDA compilation (TORCH_CUDA_ARCH_LIST)
# and is only used for 3D Gaussian Splatting (infer_gs=True, export to gs_ply / gs_video).
RUN pip install -c /etc/pip-constraints.txt -e . addict
WORKDIR /workspace

############################
# Create non-root user
############################
ARG USERNAME=developer
ARG UID=1000
ARG GID=1000
# Create ~/.cache in advance so that it is not owned by root when ~/.cache/huggingface is bind-mounted
RUN groupadd -g ${GID} ${USERNAME} \
    && useradd -m -u ${UID} -g ${GID} -s /bin/bash ${USERNAME} \
    && mkdir -p /home/${USERNAME}/.cache \
    && chown -R ${UID}:${GID} /workspace /home/${USERNAME}/.cache
USER ${USERNAME}
