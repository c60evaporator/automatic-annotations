# syntax=docker/dockerfile:1
# Base image
FROM jidohub/base-cu128-devel-ubuntu22.04:latest

# Release tag of the official MapAnything repository to install
ARG MAPANYTHING_VERSION=v1.1.3

# Install torchaudio matching torch 2.9.1 (required by uniception)
RUN pip install torchaudio==2.9.1 --index-url https://download.pytorch.org/whl/cu128
# Pin torch/torchvision/torchaudio/numpy so that the dependencies cannot replace them
# (pyarrow>=26, a dependency of rerun-sdk, doesn't support numpy 1.x)
RUN pip freeze | grep -iE "^(torch|torchvision|torchaudio|numpy)==" > /etc/pip-constraints.txt \
    && echo "pyarrow<26" >> /etc/pip-constraints.txt
# Clone MapAnything repository and install the required dependencies
WORKDIR /workspace
RUN git clone --branch ${MAPANYTHING_VERSION} --depth 1 https://github.com/facebookresearch/map-anything.git
WORKDIR /workspace/map-anything
# Install the dependencies except rerun-sdk~=0.24.1 and plyfile>=1.1.4 (they require numpy>=2 and are not used for inference)
RUN python -c "import tomllib; deps = tomllib.load(open('pyproject.toml', 'rb'))['project']['dependencies']; print('\n'.join(d for d in deps if not d.startswith('rerun-sdk')))" > /tmp/requirements.txt \
    && pip install -c /etc/pip-constraints.txt -r /tmp/requirements.txt "plyfile<1.1.4" \
    && pip install -c /etc/pip-constraints.txt --no-deps -e . \
    && rm -f /tmp/requirements.txt
# Install open3d for point cloud visualization (common/visualize) and its shared libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    libegl1 \
    libusb-1.0-0 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install -c /etc/pip-constraints.txt open3d
# Pre-fetch the DINOv2 code loaded via torch hub, so that it is not downloaded from GitHub at runtime
ENV TORCH_HOME=/opt/torch
RUN python -c "import torch; torch.hub.list('facebookresearch/dinov2', trust_repo=True)"
WORKDIR /workspace

############################
# Create non-root user
############################
ARG USERNAME=developer
ARG UID=1000
ARG GID=1000
# Create ~/.cache in advance so that it is not owned by root when ~/.cache/huggingface is bind-mounted
RUN groupadd -g ${GID} ${USERNAME} \
    && useradd -m -u ${UID} -g ${GID} -s /bin/bash ${USERNAME} \
    && mkdir -p /home/${USERNAME}/.cache \
    && chown -R ${UID}:${GID} /workspace /home/${USERNAME}/.cache ${TORCH_HOME}
USER ${USERNAME}
