# syntax=docker/dockerfile:1
# Base image
FROM jidohub/base-cu128-devel-ubuntu22.04:latest

# Versions of the official repositories to install
ARG DA3_COMMIT=3d835ec1a5802d64a8b8b15f817a1ab54809bfe4
ARG MAPANYTHING_VERSION=v1.1.3

# Shared libraries needed to import open3d (>=0.20)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libegl1 \
    libusb-1.0-0 \
    && rm -rf /var/lib/apt/lists/*

############################
# Common constraints
############################
# Install torchaudio matching torch 2.9.1 (required by uniception of MapAnything)
RUN pip install torchaudio==2.9.1 --index-url https://download.pytorch.org/whl/cu128
# Pin torch/torchvision/torchaudio/numpy of the base image so that the dependencies cannot replace them
# (pyarrow>=26 doesn't support numpy 1.x, opencv-python is aligned with opencv-python-headless of MapAnything)
RUN pip freeze | grep -iE "^(torch|torchvision|torchaudio|numpy)==" > /etc/pip-constraints.txt \
    && echo "pyarrow<26" >> /etc/pip-constraints.txt \
    && echo "opencv-python==4.10.0.84" >> /etc/pip-constraints.txt

############################
# GroundingDINO / SAM2 / SigLIP2 (Transformers)
############################
RUN pip install -c /etc/pip-constraints.txt "transformers~=5.20.0"

############################
# Depth-Anything-3
############################
# xformers 0.0.33.post2 is the prebuilt wheel for torch 2.9.1
RUN pip install -c /etc/pip-constraints.txt xformers==0.0.33.post2
WORKDIR /workspace
RUN git clone https://github.com/ByteDance-Seed/Depth-Anything-3.git \
    && git -C Depth-Anything-3 checkout ${DA3_COMMIT}
WORKDIR /workspace/Depth-Anything-3
# addict is imported by depth_anything_3 but not listed in the dependencies
RUN pip install -c /etc/pip-constraints.txt -e . addict

############################
# MapAnything
############################
WORKDIR /workspace
RUN git clone --branch ${MAPANYTHING_VERSION} --depth 1 https://github.com/facebookresearch/map-anything.git
WORKDIR /workspace/map-anything
# Install the dependencies except rerun-sdk~=0.24.1 and plyfile>=1.1.4 (they require numpy>=2)
RUN python -c "import tomllib; deps = tomllib.load(open('pyproject.toml', 'rb'))['project']['dependencies']; print('\n'.join(d for d in deps if not d.startswith('rerun-sdk')))" > /tmp/requirements.txt \
    && pip install -c /etc/pip-constraints.txt -r /tmp/requirements.txt "plyfile<1.1.4" \
    && pip install -c /etc/pip-constraints.txt --no-deps -e . \
    && rm -f /tmp/requirements.txt
# Pre-fetch the DINOv2 code loaded via torch hub
ENV TORCH_HOME=/opt/torch
RUN python -c "import torch; torch.hub.list('facebookresearch/dinov2', trust_repo=True)"

############################
# Other dependencies
############################
# Patchwork++ (ground removal) and open3d (visualization)
RUN pip install -c /etc/pip-constraints.txt pypatchworkpp open3d

WORKDIR /workspace

############################
# Create non-root user
############################
ARG USERNAME=developer
ARG UID=1000
ARG GID=1000
# Create ~/.cache in advance so that it is not owned by root when ~/.cache/huggingface is bind-mounted
RUN groupadd -g ${GID} ${USERNAME} \
    && useradd -m -u ${UID} -g ${GID} -s /bin/bash ${USERNAME} \
    && mkdir -p /home/${USERNAME}/.cache \
    && chown -R ${UID}:${GID} /workspace /home/${USERNAME}/.cache ${TORCH_HOME}
USER ${USERNAME}
